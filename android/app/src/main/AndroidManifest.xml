<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Nu declarăm CAMERA: folosim aplicația de cameră a telefonului (TakePicture),
         iar dacă am declara-o fără să o cerem, intent-ul ar fi blocat. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Android 11+: fără asta aplicația nu „vede” motorul de voce, iar ghidul audio nu pornește -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".TopulApp"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TopulAradului"
        android:usesCleartextTraffic="true">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
        </activity>

        <!-- iconița pentru paleta 1; doar una e activă (vezi AppIcon.kt) -->
        <activity-alias
            android:name=".LauncherArgint"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_p1"
            android:roundIcon="@mipmap/ic_launcher_p1">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- iconița pentru paleta 2; doar una e activă (vezi AppIcon.kt) -->
        <activity-alias
            android:name=".LauncherAmurg"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_p2"
            android:roundIcon="@mipmap/ic_launcher_p2">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- iconița pentru paleta 3; doar una e activă (vezi AppIcon.kt) -->
        <activity-alias
            android:name=".LauncherTrandafir"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher_p3"
            android:roundIcon="@mipmap/ic_launcher_p3">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- iconița pentru paleta 4; doar una e activă (vezi AppIcon.kt) -->
        <activity-alias
            android:name=".LauncherCaramida"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_p4"
            android:roundIcon="@mipmap/ic_launcher_p4">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- iconița pentru paleta 5; doar una e activă (vezi AppIcon.kt) -->
        <activity-alias
            android:name=".LauncherMures"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_p5"
            android:roundIcon="@mipmap/ic_launcher_p5">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>

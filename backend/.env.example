# Copiază în .env (local) sau pune-le ca „Variables” pe Railway.

# Implicit: SQLite local (backend/topul.db). Pe Railway, DATABASE_URL vine automat din serviciul Postgres:
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# OBLIGATORIU online. Generează una cu: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=schimba-ma

# Pozele de la check-in. Pe Railway: atașează un Volume montat la /data
# UPLOAD_DIR=/data/uploads

CHECKIN_RADIUS_M=100
CHECKIN_COOLDOWN_MIN=30
# true DOAR la demo, când juriul face check-in din sală la locuri din oraș
SKIP_DISTANCE_CHECK=false

# Login cu Google: Client ID-ul de tip „Web application” din Google Cloud
# GOOGLE_CLIENT_IDS=123456-abc.apps.googleusercontent.com

# Resetare parolă prin email (ex. Gmail cu „App password”). Fără ele, codul apare doar în log-ul serverului.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=adresa.ta@gmail.com
# SMTP_PASSWORD=parola-de-aplicatie-16-caractere
# SMTP_FROM=Topul Aradului <adresa.ta@gmail.com>
